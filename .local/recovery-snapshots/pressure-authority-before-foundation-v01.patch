+def apply_fortify_to_node(node: Dict[str, Any]) -> None:
+    """Fortify reduces or stabilises environmental threat pressure."""
+    node["magnitude"] = _clamp_magnitude(int(node.get("magnitude") or 0) + FORTIFY_ENVIRONMENTAL_DELTA)
+    node["trend"] = min(0, int(node.get("trend") or 0))
