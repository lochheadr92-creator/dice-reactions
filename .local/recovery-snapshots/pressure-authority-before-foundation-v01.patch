+def magnitude_to_urgency_band(magnitude: int) -> str:
+    mag = _clamp_magnitude(magnitude)
+    if mag >= 80:
+        return "critical"
+    if mag >= 60:
+        return "high"
+    if mag >= 35:
+        return "elevated"
+    return "low"
