+def get_foreground_node(graph: Mapping[str, Any]) -> Optional[Dict[str, Any]]:
+    fg_id = graph.get("foreground_node_id")
+    if not fg_id:
+        return None
+    for node in graph.get("nodes") or []:
+        if (
+            isinstance(node, dict)
+            and node.get("id") == fg_id
+            and node.get("status") == "active"
+        ):
+            return node
+    return None
+
+
+def derive_pressure_projections(graph: Mapping[str, Any]) -> List[Dict[str, Any]]:
+    """Deterministic bounded projections from engine nodes — compatibility/presentation only."""
+    fg_id = graph.get("foreground_node_id")
+    projections: List[Dict[str, Any]] = []
+    for node in _active_nodes(graph):
+        projections.append({
+            "pressure_id": str(node.get("id") or ""),
+            "label": str(node.get("label") or node.get("kind") or "pressure").strip()[:80],
+            "kind": str(node.get("kind") or ""),
+            "urgency_band": magnitude_to_urgency_band(int(node.get("magnitude") or 0)),
+            "foreground": node.get("id") == fg_id,
+        })
+    projections.sort(key=lambda row: (not row["foreground"], row["pressure_id"]))
+    return projections
+
+
+def derive_active_pressures_compatibility(graph: Mapping[str, Any]) -> List[str]:
+    """Bounded string list for pacing prompts — derived from engine authority."""
+    labels: List[str] = []
+    for projection in derive_pressure_projections(graph):
+        label = str(projection.get("label") or "").strip()
+        if label and label not in labels:
+            labels.append(label)
+        if len(labels) >= 3:
+            break
+    return labels
+
+
+def sync_active_pressures_projection(
+    rolling: Dict[str, Any],
+    graph: Mapping[str, Any],
+) -> List[str]:
+    """Replace model-authored active_pressures with engine-derived compatibility projection."""
+    derived = derive_active_pressures_compatibility(graph)
+    adjustments: List[str] = []
+    if rolling.get("active_pressures") != derived:
+        rolling["active_pressures"] = derived
+        adjustments.append("active_pressures_derived_from_engine")
+    return adjustments
+
+
+def derive_engine_pressure_phrase(graph: Mapping[str, Any]) -> str:
+    """Presentation phrase from foreground engine node — model may not select a different pressure."""
+    node = get_foreground_node(graph)
+    if not node:
+        active = _active_nodes(graph)
+        if not active:
+            return ""
+        node = max(active, key=lambda n: int(n.get("magnitude") or 0))
+    label = str(node.get("label") or node.get("kind") or "").strip().replace("_", " ")
+    if not label:
+        return ""
+    trend = int(node.get("trend") or 0)
+    if trend > 0:
+        return f"{label} intensifying"[:64]
+    if trend < 0:
+        return f"{label} easing"[:64]
+    return label[:64]
+
+
+def apply_gather_to_node(node: Dict[str, Any]) -> None:
+    """Gather reduces targeted resource pressure magnitude."""
