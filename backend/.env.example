# Backend environment example — copy to backend/.env and fill in real values.
# Never commit backend/.env (ignored). Values below are placeholders only.

# MongoDB MUST be a replica set or sharded cluster: turn commits run in
# multi-document transactions and the server refuses paid writes otherwise.
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=dice_reaction

# Provider credentials (leave empty to run without a configured provider).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Local Ollama instead of a cloud provider (OpenAI-compatible route):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama          (any non-empty value; Ollama ignores it)
#   DEFAULT_MODEL=openai-direct/<ollama model name>
#   FALLBACK_MODELS=openai-direct/<ollama model name>
#   OPENAI_DIRECT_REASONING_EFFORT=none   (turns thinking off for thinking models)
#   OPENAI_DIRECT_ASSISTANT_PREFILL=true  (starts each turn reply with the state block)

# Antivirus HTTPS scanning (e.g. Norton) breaks certifi-based TLS checks:
# SSL_USE_SYSTEM_TRUST_STORE=true

# Second-pass mature prose renderer (off by default; see docs/failure-modes.md FM-30)
# MATURE_RENDERER_ENABLED=true
# MATURE_MODEL_ID=openai-direct/<pinned model>
# DISTRIBUTION_CHANNEL=development
# ENABLE_MATURE_CONTENT=true

# Narration length for new stories: brief | standard | story | cinematic
# DEFAULT_PROSE_MODE=standard

# Admin API (X-Admin-Api-Key header). Required for /admin/* routes.
ADMIN_API_KEY=replace-with-a-long-random-secret

CORS_ORIGINS=*
ENABLE_DEBUG_PANEL=true

# ---- Paid-work limits (conservative defaults shown; see docs/api.md) ----
# Story creation
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_DEVICE_MAX=5
RATE_LIMIT_GLOBAL_MAX=50
RATE_LIMIT_GLOBAL_CONCURRENT=3
# Player actions
RATE_LIMIT_ACTION_DEVICE_MAX=60
RATE_LIMIT_ACTION_DEVICE_WINDOW_SEC=3600
# Provider boundary (applies to creation AND actions)
PROVIDER_ATTEMPTS_PER_ACTION=8
ACTION_GENERATION_DEADLINE_SEC=240
PROVIDER_GLOBAL_ATTEMPT_MAX=500
PROVIDER_GLOBAL_ATTEMPT_WINDOW_SEC=3600
PROVIDER_GLOBAL_CONCURRENT=4
# Input limits
ACTION_TEXT_MAX_CHARS=2000
CREATION_TEXT_FIELD_MAX_CHARS=2000
CREATION_SETUP_TOTAL_MAX_CHARS=12000
